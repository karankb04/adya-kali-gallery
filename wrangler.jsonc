{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kali-gallery",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Served only on kali.gallery (custom domain set in the dashboard); no
  // public *.workers.dev copy or preview URLs that search engines could index.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "R2_BASE_URL": "https://images.kali.gallery"
  },
  // 00:05 UTC = 05:35 India time, just after Today's Darshan (picked by UTC
  // date) rolls over. Needs the DEPLOY_HOOK_URL secret set in the dashboard.
  "triggers": { "crons": ["5 0 * * *"] }
}
