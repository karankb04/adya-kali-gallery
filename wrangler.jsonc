{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kali-gallery",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Live site only on kali.gallery (custom domain set in the dashboard); no
  // public *.workers.dev copy. Preview links (*.karanb0406.workers.dev) are on
  // for testing branches before they go live; public/_headers marks them noindex.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "R2_BASE_URL": "https://images.kali.gallery"
  },
  // 00:05 UTC = 05:35 India time, just after Today's Darshan (picked by UTC
  // date) rolls over. Needs the DEPLOY_HOOK_URL secret set in the dashboard.
  "triggers": { "crons": ["5 0 * * *"] }
}
